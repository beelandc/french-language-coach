{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest:*)",
      "Bash(python3 scripts/validate_grammar_lessons.py:*)",
      "Bash(python3 scripts/validate_grammar_reference.py:*)",
      "Bash(npm run test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test:storybook)",
      "Bash(npm run test:jest)",
      "Bash(npm run test:jest:coverage)",
      "Bash(npm run lint)",
      "Bash(npx vitest list:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc -b)",
      "Bash(date:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  }
}
