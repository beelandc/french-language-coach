# Mistral API key. Required when any feature uses the "mistral" provider (the default).
MISTRAL_API_KEY=
DATABASE_URL=sqlite+aiosqlite:///./french_coach.db

# Anthropic API key. Required when any feature uses the "anthropic" provider (Claude).
ANTHROPIC_API_KEY=

# LLM provider and model per feature. Provider: "mistral" or "anthropic".
# chat = scenario role-play and the opening greeting; feedback = end-of-session report.
CHAT_PROVIDER=mistral
CHAT_MODEL=mistral-large-latest
FEEDBACK_PROVIDER=mistral
FEEDBACK_MODEL=mistral-large-latest

# Optional Claude effort per feature: low | medium | high | xhigh | max.
# When unset: chat=low, feedback=medium.
# CLAUDE_CHAT_EFFORT=low
# CLAUDE_FEEDBACK_EFFORT=medium

# Optional path to the LLM price table used for cost estimates.
# LLM_PRICING_FILE=data/llm_pricing.json
