# Anthropic API key. Required when any feature uses the "anthropic" provider
# (Claude, the default for both features; see docs/decisions/001-model-choice.md).
ANTHROPIC_API_KEY=

# Mistral API key. Required when any feature uses the "mistral" provider, and for
# the eval harness's default judge (evals/README.md).
MISTRAL_API_KEY=
DATABASE_URL=sqlite+aiosqlite:///./french_coach.db

# LLM provider and model per feature. Provider: "mistral" or "anthropic".
# chat = scenario role-play and the opening greeting; feedback = end-of-session report.
# Explicit values here override the defaults. To use Mistral Large for a feature,
# set its provider to mistral and its model to mistral-large-latest.
CHAT_PROVIDER=anthropic
CHAT_MODEL=claude-sonnet-5-5
FEEDBACK_PROVIDER=anthropic
FEEDBACK_MODEL=claude-sonnet-5-5

# Optional Claude effort per feature: low | medium | high | xhigh | max.
# When unset: chat=low, feedback=medium.
# CLAUDE_CHAT_EFFORT=low
# CLAUDE_FEEDBACK_EFFORT=medium

# Optional path to the LLM price table used for cost estimates.
# LLM_PRICING_FILE=data/llm_pricing.json

# French feedback rubric appended to the feedback prompt (on by default). Set
# FEEDBACK_RUBRIC=false to send the bare feedback prompt. The file is the canonical
# rubric, also used by the french-feedback-rubric Claude Code skill.
# FEEDBACK_RUBRIC=true
# FEEDBACK_RUBRIC_FILE=data/feedback_rubric.md
