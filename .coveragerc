# coverage.py configuration (read automatically by coverage.py and pytest-cov
# when run from the repo root).

[run]
# Issue #249: SQLAlchemy's async session runs ORM work inside greenlets, which
# coverage.py doesn't trace by default, so router lines after `await db.…`
# showed as missed. TestClient runs the app on a separate thread, so thread
# tracing is needed as well. coverage.py allows `thread` plus one other library.
concurrency = thread,greenlet
source = .
omit =
    tests/*
    frontend/*
    .venv/*
    scripts/*
    # Issue #252: standalone generator of data/vocabulary_cards/*.json. The app
    # and tests never import it, so it's in the same category as scripts/.
    # (seed_database.py is NOT omitted: main.py runs it on first startup.)
    seed_all_decks.py

[report]
# Issue #252: single source of truth for the coverage threshold. pytest-cov
# uses it as the default for --cov-fail-under, and
# scripts/check_module_coverage.py applies it to each module.
fail_under = 80
